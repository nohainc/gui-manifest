{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gui-manifest/v1.json",
  "title": "GUI Manifest v1 (draft) \u2014 validates the decoded Nano Markup tree (all scalars are strings)",
  "type": "object",
  "required": [
    "manifestVersion",
    "cli",
    "navigation",
    "commands"
  ],
  "properties": {
    "manifestVersion": {
      "const": "1"
    },
    "cli": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "navigation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "screen": {
            "type": "string"
          },
          "builtin": {
            "type": "string"
          }
        },
        "oneOf": [
          {
            "required": [
              "command"
            ]
          },
          {
            "required": [
              "screen"
            ]
          },
          {
            "required": [
              "builtin"
            ]
          }
        ]
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "required": [
        "id",
        "argv",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "output": {
          "type": "object",
          "properties": {
            "format": {
              "enum": [
                "text",
                "json",
                "jsonLines",
                "nano"
              ]
            },
            "view": {
              "enum": [
                "form",
                "table",
                "keyValue",
                "card",
                "log",
                "confirm",
                "raw"
              ]
            }
          }
        },
        "destructive": {
          "enum": [
            "true",
            "false"
          ]
        },
        "interactive": {
          "enum": [
            "true",
            "false"
          ]
        },
        "longRunning": {
          "enum": [
            "true",
            "false"
          ]
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hidden": {
          "enum": [
            "true",
            "false"
          ]
        },
        "group": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "parameter": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "option",
            "flag",
            "positional"
          ]
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "enum",
            "path",
            "secret"
          ]
        },
        "required": {
          "enum": [
            "true",
            "false"
          ]
        },
        "default": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "multiple": {
          "enum": [
            "true",
            "false"
          ]
        },
        "label": {
          "type": "string"
        },
        "help": {
          "type": "string"
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-zA-Z0-9]*)*$"
    },
    "group": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "parent": {
          "$ref": "#/$defs/id"
        }
      }
    }
  }
}
