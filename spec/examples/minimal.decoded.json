{
  "manifestVersion": "1",
  "cli": {
    "name": "example",
    "version": "0.1.0",
    "displayName": "Example CLI",
    "description": "Example CLI"
  },
  "navigation": [
    {
      "id": "status",
      "label": "Status",
      "icon": "pulse",
      "command": "status"
    },
    {
      "id": "workers",
      "label": "Workers",
      "icon": "cpu",
      "command": "workers.list"
    }
  ],
  "groups": [
    {
      "id": "workers",
      "label": "Workers",
      "icon": "cpu",
      "description": "Manage workers."
    }
  ],
  "commands": [
    {
      "id": "status",
      "argv": [
        "status",
        "--json"
      ],
      "title": "Status",
      "description": "Show status.",
      "output": {
        "format": "json",
        "view": "keyValue"
      }
    },
    {
      "id": "workers.list",
      "argv": [
        "workers",
        "list",
        "--json"
      ],
      "title": "List workers",
      "description": "List workers.",
      "group": "workers",
      "output": {
        "format": "json",
        "view": "table"
      }
    },
    {
      "id": "workers.remove",
      "argv": [
        "workers",
        "remove"
      ],
      "title": "Remove worker",
      "description": "Remove worker.",
      "group": "workers",
      "destructive": "true",
      "parameters": [
        {
          "name": "id",
          "kind": "positional",
          "type": "string",
          "required": "true",
          "label": "Worker ID"
        }
      ],
      "output": {
        "format": "text",
        "view": "raw"
      }
    }
  ]
}
